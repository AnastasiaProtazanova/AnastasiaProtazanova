Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.Скидки.Очистить();
	
	Движения.Скидки.Записывать = Истина;
	
	Движение = Движения.Скидки.Добавить();	
	
	Для Каждого Строка Из Скидки Цикл
		Движение.Период = Дата;
		Движение.НоменклатураНоменклатурнаяГруппа = Строка.НоменклатураНоменклатурнаяГруппа;
		Движение.Скидка = Строка.Скидка;
	КонецЦикла; 
	
КонецПроцедуры 
